<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The build only needs nuget.org; clearing inherited sources keeps restores working on machines with a custom global NuGet.config. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
